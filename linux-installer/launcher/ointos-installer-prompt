#!/bin/bash
# ============================================================================
# OintOS installer prompt — launches Calamares from the live KDE session.
#
# Mirrors Kubuntu's kubuntu-installer-prompt behavior. Launches Calamares as
# root (it needs partition/bootloader privileges) while preserving the X/Wayland
# display env so the GUI appears on the live desktop. (Kubuntu hit a Wayland +
# sudo-rs env-passing bug — LP #2124199 — fixed by passing these explicitly.)
#
# Not installed in the installed system; only used in the live session.
# ============================================================================
set -euo pipefail

# If not on a live medium, calm-complain and exit.
if ! command -v calamares >/dev/null 2>&1; then
    echo "OintOS installer is only available from the live session." >&2
    exit 1
fi

# --- Preserve display env through sudo (Wayland/X11) -----------------------
# Only pass vars that are actually set: passing an empty DISPLAY= would
# blank the display for the root process and the GUI would never appear.
SUDO_ENV=()
for _v in DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR QT_QPA_PLATFORMTHEME XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS; do
    [ -n "${!_v:-}" ] && SUDO_ENV+=("$_v=${!_v}")
done

# --- Launch Calamares as root, preserving the graphics env -----------------
# Calamares 3.3.x does NOT have --is-installer; it reads the installer mode
# from settings.conf (the sequence with exec modules is what makes it an
# installer). We pass -c /etc/calamares to be explicit about config location.
# shellcheck disable=SC2086
sudo -E env "${SUDO_ENV[@]}" calamares -c /etc/calamares