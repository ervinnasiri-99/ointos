---
# OintOS branding for Calamares
# (Calamares branding.desc — see https://calamares.io/docs/components/branding.html)
# CRITICAL: Calamares 3.3.x merges this with the default branding from
# calamares-data. If we don't override a key, the default's value is used.
# The `images` key must be explicitly set here (even empty) to shadow the
# default's productIcon/productLogo/productWelcome which use squid.png.
componentName:  ointos
name:           OintOS
version:        1.0
shortVersion:   1.0
website:        https://github.com/ervinnasiri-99/ointos
image:          "img/logo.png"
logo:           "img/logo.png"
# OintOS orchid palette — Calamares finds stylesheet.qss by convention
# in the branding directory; do not specify 'style' as a string (Calamares
# expects a map if present, which causes a YAML parse error).

# Override images from default branding (squid.png) with OintOS logo
images:
    productIcon:  "img/logo.png"
    productLogo:  "img/logo.png"
    productWelcome: "img/logo.png"

# Welcome / general strings
strings:
    productName:         OintOS
    shortProductName:    OintOS
    version:             1.0
    shortVersion:        1.0
    versionedName:       "OintOS 1.0"
    shortVersionedName:  "OintOS 1.0"
    bootloaderEntryName: "OintOS"

# Slideshow: the QML that plays during install
slideshow: "show.qml"
slideshowAPI: 1

# Default window size
windowWidth:  800
windowHeight: 520