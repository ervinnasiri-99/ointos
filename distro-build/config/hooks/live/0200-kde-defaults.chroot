#!/bin/sh
# Configure KDE Plasma defaults for OintOS

set -e

# Set Breeze as default Qt theme
mkdir -p /etc/xdg
cat > /etc/xdg/kdeglobals << 'EOF'
[KDE]
widgetStyle=Breeze

[General]
ColorScheme=Breeze
EOF

# Set default wallpaper (placeholder — will be replaced in Phase 14)
mkdir -p /usr/share/wallpapers/ointos/contents/images
cat > /usr/share/wallpapers/ointos/metadata.desktop << 'EOF'
[Desktop Entry]
Name=OintOS Default
X-KDE-PluginInfo-Name=ointos
EOF

echo "OintOS: KDE defaults configured"
